# Copy to `.env.local` for local dev (Next.js reads `.env.local` automatically).

# Waitlist API (`POST /api/waitlist`) — server-only; do not prefix with NEXT_PUBLIC_
MONGODB_URI=
MONGODB_DATABASE=

# Privy — required for embedded wallet / auth (get app ID from https://dashboard.privy.io)
NEXT_PUBLIC_PRIVY_APP_ID=

# Backend API (default matches backend PORT=3001)
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001

# Deployed LineFutures — optional; predict page has a hardcoded fallback if unset
NEXT_PUBLIC_FUTURES_CONTRACT_ADDRESS=

# Optional — override default public Base RPC
# NEXT_PUBLIC_ETHEREUM_RPC_URL=https://mainnet.base.org

# Optional — should match backend ETH_USD_RATE when using Yellow USDC conversion
# NEXT_PUBLIC_ETH_USD_RATE=3000

# Pitch page walkthrough video (GitHub max 100MB — host on R2/S3/Cloudflare Stream and paste URL)
# NEXT_PUBLIC_PITCH_WALKTHROUGH_VIDEO_URL=https://example.com/DrawFi-Walkthrough.mp4

# Yellow ClearNode — portfolio deposit/withdraw
# NEXT_PUBLIC_YELLOW_WS_URL=wss://clearnet.yellow.com/ws
# NEXT_PUBLIC_YELLOW_CHAIN_ID=84532

# Yellow custody contracts (required for deposit/withdraw)
# NEXT_PUBLIC_CUSTODY_ADDRESS=0x8658501c98C3738026c4e5c361c6C3fa95DfB255
# NEXT_PUBLIC_ADJUDICATOR_ADDRESS=0xcbbc03a873c11beeFA8D99477E830be48d8Ae6D7
